# Copy this file to `.env` and fill in the values. Never commit `.env` (it's in .gitignore).
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac/Linux:             cp .env.example .env

# NASA API key, used by scripts/fetch-asteroids.js to save the NeoWs asteroid snapshot.
# Free and instant: https://api.nasa.gov/  (sign up with name + email, the key is emailed to you)
# DEMO_KEY works for a quick test but is rate-limited (about 30 requests/hour).
NASA_API_KEY=DEMO_KEY

# Planned later (live "asteroids passing Earth today" refresh in the hub):
# Do NOT rename this to VITE_NASA_API_KEY. Anything starting with VITE_ is baked into the
# public website where anyone can read it. The live refresh will need a tiny proxy
# (e.g. a Netlify function) that keeps the key server-side.
